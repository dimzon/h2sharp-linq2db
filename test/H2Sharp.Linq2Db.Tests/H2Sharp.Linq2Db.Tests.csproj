<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>H2Sharp.Linq2Db.Tests</AssemblyName>
    <RootNamespace>H2Sharp.Linq2Db.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <H2SharpProject Condition="'$(H2SharpProject)' == ''">$(MSBuildThisFileDirectory)..\..\..\h2sharp\src\H2Sharp\H2Sharp.csproj</H2SharpProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.assert" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\H2Sharp.Linq2Db\H2Sharp.Linq2Db.csproj" />
    <ProjectReference Include="$(H2SharpProject)" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

</Project>
