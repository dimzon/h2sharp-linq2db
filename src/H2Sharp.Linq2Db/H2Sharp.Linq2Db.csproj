<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>H2Sharp.Linq2Db</AssemblyName>
    <RootNamespace>LinqToDB.DataProvider.H2Sharp</RootNamespace>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    H2Sharp is the embedded H2 port this provider sits on. It is a sibling repository and is not
    published to nuget.org yet, so it comes in as a project reference. Set H2SharpProject to point
    elsewhere once the engine ships as a package.
  -->
  <PropertyGroup>
    <H2SharpProject Condition="'$(H2SharpProject)' == ''">$(MSBuildThisFileDirectory)..\..\..\h2sharp\src\H2Sharp\H2Sharp.csproj</H2SharpProject>
  </PropertyGroup>

  <!--
    linq2db comes from a local checkout too, not from the nuget package: the core is being
    instrumented while the provider's behaviour is being worked out, and a package cannot be
    instrumented. Set LinqToDbProject to point elsewhere to build against the released package.
  -->
  <PropertyGroup>
    <LinqToDbProject Condition="'$(LinqToDbProject)' == ''">$(MSBuildThisFileDirectory)..\..\..\linq2db\Source\LinqToDB\LinqToDB.csproj</LinqToDbProject>
  </PropertyGroup>

  <!--
    The references are not pinned to a framework: the engine and the core of linq2db both have a
    net8.0 and a net10.0 build, and each target of this provider takes the one that matches it.
  -->
  <ItemGroup>
    <ProjectReference Include="$(LinqToDbProject)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(H2SharpProject)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\..\NOTICE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
